{
  "name": "ecb-euro-exchange-rates",
  "description": "Retrieve Euro foreign exchange reference rates from the European Central Bank",
  "author": "Philipp Katz <philipp@philippkatz.de>",
  "version": "5.0.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/qqilihq/ecb-euro-exchange-rates/issues"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/qqilihq/ecb-euro-exchange-rates.git"
  },
  "keywords": [
    "euro",
    "currency",
    "rates",
    "ecb",
    "typescript"
  ],
  "scripts": {
    "test": "node --require tsx/cjs --test ./test/index.test.ts",
    "test:watch": "node --require tsx/cjs --test --watch ./test/index.test.ts",
    "test:coverage": "c8 --reporter=html --reporter=json node --require tsx/cjs --test ./test/index.test.ts",
    "lint": "eslint --ext .ts ./lib ./test",
    "build": "tsc -p tsconfig.build.json",
    "clean": "node -e \"['./coverage', './dist'].forEach(entry => require('fs').rmSync(entry, { recursive: true, force: true }));\"",
    "preversion": "pnpm run clean && pnpm run lint && pnpm test && pnpm run build",
    "release": "pnpm version --message \"chore: release %s\""
  },
  "dependencies": {
    "fast-xml-parser": "^5.3.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^17.0.3",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22",
    "c8": "^11.0.0",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "husky": "^9.0.0",
    "prettier": "^2.7.1",
    "tsx": "^4.20.6",
    "typescript": "5.5.4",
    "typescript-eslint": "^8.58.1"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=11"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.20.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@11.25.0"
}
