{
  "name": "ecb-euro-exchange-rates",
  "description": "Retrieve Euro foreign exchange reference rates from the European Central Bank",
  "author": "Philipp Katz <philipp@philippkatz.de>",
  "version": "6.0.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "bugs": {
    "url": "https://github.com/qqilihq/ecb-euro-exchange-rates/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qqilihq/ecb-euro-exchange-rates.git"
  },
  "keywords": [
    "euro",
    "currency",
    "rates",
    "ecb",
    "typescript"
  ],
  "scripts": {
    "test": "node --require tsx/cjs --test ./test/index.test.ts",
    "test:watch": "node --require tsx/cjs --test --watch ./test/index.test.ts",
    "test:coverage": "c8 --reporter=html --reporter=json node --require tsx/cjs --test ./test/index.test.ts",
    "lint": "pnpm run lint:eslint && pnpm run lint:format && pnpm run lint:types && pnpm run lint:knip",
    "lint:eslint": "eslint .",
    "lint:format": "prettier --check .",
    "lint:knip": "knip",
    "lint:types": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "clean": "node -e \"['./coverage', './dist'].forEach(entry => require('fs').rmSync(entry, { recursive: true, force: true }));\"",
    "preversion": "pnpm run clean && pnpm run lint && pnpm test && pnpm run build && tsx ./dev/verify-changelog.ts",
    "release": "pnpm version --message \"chore: release %s\"",
    "version": "tsx ./dev/verify-changelog.ts --match-version",
    "prepare": "husky"
  },
  "dependencies": {
    "fast-xml-parser": "^5.3.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22",
    "c8": "^12.0.0",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.3.0",
    "husky": "^9.0.0",
    "knip": "^6.34.0",
    "lint-staged": "^17.4.1",
    "prettier": "^3.9.6",
    "tsx": "^4.20.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.58.1"
  },
  "engines": {
    "node": ">=22"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.20.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@11.25.0"
}
