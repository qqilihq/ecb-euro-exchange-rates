{
  "name": "ecb-euro-exchange-rates",
  "description": "Retrieve Euro foreign exchange reference rates from the European Central Bank",
  "author": "Philipp Katz <philipp@philippkatz.de>",
  "version": "5.0.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/qqilihq/ecb-euro-exchange-rates/issues"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/qqilihq/ecb-euro-exchange-rates.git"
  },
  "keywords": [
    "euro",
    "currency",
    "rates",
    "ecb",
    "typescript"
  ],
  "scripts": {
    "test": "node --require tsx/cjs --test ./test/index.test.ts",
    "test:watch": "node --require tsx/cjs --test --watch ./test/index.test.ts",
    "test:coverage": "c8 --reporter=html node --require tsx/cjs --test ./test/index.test.ts",
    "lint": "eslint --ext .ts ./lib ./test",
    "build": "tsc -p tsconfig.build.json",
    "clean": "node -e \"['./coverage', './dist'].forEach(entry => require('fs').rmSync(entry, { recursive: true, force: true }));\"",
    "preversion": "yarn clean && yarn lint && yarn test && yarn build",
    "prepare": "husky install"
  },
  "dependencies": {
    "fast-xml-parser": "^5.3.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^17.0.3",
    "@eslint/js": "^9.39.1",
    "@types/node": "^18",
    "c8": "^10.1.3",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "husky": "^7.0.0",
    "prettier": "^2.7.1",
    "pretty-quick": "^3.1.3",
    "tsx": "^4.20.6",
    "typescript": "^4.7.4",
    "typescript-eslint": "^8.47.0"
  },
  "engines": {
    "node": ">=18"
  },
  "volta": {
    "node": "18.19.0",
    "yarn": "1.22.19"
  }
}
